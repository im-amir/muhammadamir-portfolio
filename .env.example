# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form messages are delivered (defaults to the email in data/content.ts)
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# Defaults to Resend's test sender, which only delivers to your Resend account email.
CONTACT_FROM_EMAIL=

# Optional: canonical site URL for SEO (sitemap, Open Graph, schema), e.g. https://yourdomain.com
# Leave empty on Netlify to use the site's .netlify.app address automatically.
NEXT_PUBLIC_SITE_URL=
